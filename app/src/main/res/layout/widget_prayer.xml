<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical"
    android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/city" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#9DB8AE" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#9DB8AE" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="2dp">
        <TextView android:id="@+id/next" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#E8BE5C" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
        <Chronometer android:id="@+id/cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#E8BE5C" android:textSize="26sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/cells" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/c0" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c2" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c3" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c4" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t4" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/c5" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#9DB8AE" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t5" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#F3EFE4" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
